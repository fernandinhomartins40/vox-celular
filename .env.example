# Deployment secrets are generated once by GitHub Actions on the VPS.
POSTGRES_PASSWORD=replace-with-random-hex-64-characters
JWT_SECRET=replace-with-random-at-least-32-characters
ADMIN_EMAIL=lojista@vox.com
ADMIN_PASSWORD=replace-with-random-at-least-12-characters
CORS_ORIGIN=https://www.voxcelular.com.br
PUBLIC_STORE_KEY=vox-celular
DEPLOY_PORT=3196
# Immutable image references are provided by release.env, not build on VPS.
API_IMAGE=ghcr.io/fernandinhomartins40/vox-celular-api:your-release
WEB_IMAGE=ghcr.io/fernandinhomartins40/vox-celular-web:your-release
MIGRATION_IMAGE=ghcr.io/fernandinhomartins40/vox-celular-migration:your-release
DB_POOL_SIZE=5
API_MEMORY_LIMIT=768m
DB_MEMORY_LIMIT=512m
WEB_MEMORY_LIMIT=64m
MIGRATION_MEMORY_LIMIT=512m
