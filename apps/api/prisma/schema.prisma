generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Multi-tenant: each Loja is a tenant
model Loja {
  id        String   @id @default(cuid())
  chavePublica String? @unique
  nome      String
  telefone  String
  endereco  String
  cidade    String
  mapsUrl   String
  createdAt DateTime @default(now())

  usuarios   Usuario[]
  produtos   Produto[]
  pedidos    Pedido[]
  clientes   Cliente[]
  promocoes  Promocao[]
  recompensas RecompensaCatalogo[]
  config     LojaConfig?
  integracoes IntegracaoMarketplace[]
  servicos Servico[]
  guiasOperadora GuiaOperadora[]
  novidades Novidade[]
  solicitacoesServico SolicitacaoServico[]
  orcamentosIa OrcamentoIa[]
  configuracaoIa ConfiguracaoIa?
  notificacoes NotificacaoCliente[]
}

model SolicitacaoEncerramentoConta {
  id String @id @default(cuid())
  clienteId String @unique
  status String @default("SOLICITADA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  analiseIniciadaEm DateTime?
  analisadoPorId String?
  analisadoPor Usuario? @relation(fields: [analisadoPorId], references: [id], onDelete: Restrict)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
}

model NotificacaoCliente {
  id String @id @default(cuid())
  lojaId String
  clienteId String
  chaveEvento String
  titulo String
  mensagem String
  destino String
  status String @default("PENDENTE")
  tentativas Int @default(0)
  createdAt DateTime @default(now())
  proximaTentativaEm DateTime @default(now())
  expiresAt DateTime @default(now())
  loja Loja @relation(fields: [lojaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])
  entregas EntregaPush[]
  @@unique([clienteId, chaveEvento])
  @@index([status, proximaTentativaEm])
  @@index([expiresAt, id])
}

model ConfiguracaoIa {
  id String @id @default(cuid())
  lojaId String @unique
  provedor String
  modelo String
  workspace String?
  credenciais String
  limiteMicroUsd BigInt
  tarifaEntradaMicroUsd BigInt
  tarifaSaidaMicroUsd BigInt
  updatedAt DateTime @updatedAt
  loja Loja @relation(fields: [lojaId], references: [id])
}

model OrcamentoIa {
  id String @id @default(cuid())
  lojaId String
  mes String
  limiteMicroUsd BigInt
  gastoMicroUsd BigInt @default(0)
  reservadoMicroUsd BigInt @default(0)
  updatedAt DateTime @updatedAt
  loja Loja @relation(fields: [lojaId], references: [id])
  reservas ReservaIa[]
  @@unique([lojaId, mes])
}

model ReservaIa {
  id String @id @default(cuid())
  orcamentoId String
  valorMicroUsd BigInt
  custoMicroUsd BigInt?
  status String @default("RESERVADA")
  createdAt DateTime @default(now())
  encerradaEm DateTime?
  orcamento OrcamentoIa @relation(fields: [orcamentoId], references: [id])
  @@index([orcamentoId, status])
}

model IntegracaoMarketplace {
  id String @id @default(cuid())
  lojaId String
  canal String
  ambiente String @default("producao")
  credenciais String
  campos String[]
  status String @default("CONFIGURADO")
  verificadoEm DateTime?
  updatedAt DateTime @updatedAt
  loja Loja @relation(fields: [lojaId], references: [id])
  @@unique([lojaId, canal])
}

model LojaConfig {
  id          String   @id @default(cuid())
  lojaId      String   @unique
  heroSlide1Titulo    String @default("Plano TIM Controle com 20 GB + apps")
  heroSlide1Sub       String @default("Portabilidade grátis, ativação na hora.")
  heroSlide1Preco     String @default("49,90")
  instagramUrl        String @default("")
  facebookUrl         String @default("")
  horarioSemana       String @default("Seg–Sex 8h–19h")
  horarioSabado       String @default("Sáb 8h–13h")
  landingPage         Json @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  loja Loja @relation(fields: [lojaId], references: [id])
}

model Usuario {
  id           String   @id @default(cuid())
  lojaId       String
  nome         String
  email        String
  senhaHash    String
  tokenVersion Int      @default(0)
  role         Role     @default(CLIENTE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  loja         Loja     @relation(fields: [lojaId], references: [id])
  cliente      Cliente?
  sessoes      Sessao[]
  analisesEncerramento SolicitacaoEncerramentoConta[]
  novidadesRevisadas Novidade[]
  orcamentosServicoEmitidos OrcamentoServico[]
  compatibilidadesAprovadas CompatibilidadeProduto[]

  @@unique([lojaId, email])
  @@index([email])
}

enum Role {
  LOJISTA
  CLIENTE
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  tokenVersion Int @default(0)
  @@index([usuarioId, expiresAt])

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Cliente {
  id         String   @id @default(cuid())
  lojaId     String
  usuarioId  String   @unique
  telefone   String
  cidade     String
  pontos     Int      @default(0)
  nivel      String   @default("Bronze")
  totalGasto Decimal  @default(0) @db.Decimal(10,2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  loja       Loja     @relation(fields: [lojaId], references: [id])
  usuario    Usuario  @relation(fields: [usuarioId], references: [id])
  pedidos    Pedido[]
  historicoP HistoricoPontos[]
  favoritos Favorito[]
  personalizacao Boolean @default(false)
  notificacoes Boolean @default(false)
  versaoPrivacidade String?
  preferenciasAtualizadasEm DateTime?
  consentimentos ConsentimentoCliente[]
  filaNotificacoes NotificacaoCliente[]
  assinaturasPush AssinaturaPush[]
  solicitacoesServico SolicitacaoServico[]
  encerramentoConta SolicitacaoEncerramentoConta?
  @@index([lojaId, createdAt])
}

model AssinaturaPush {
  id String @id @default(cuid())
  lojaId String
  clienteId String
  endpointHash String @unique
  credenciais String
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cliente Cliente @relation(fields: [clienteId], references: [id])
  entregas EntregaPush[]
  @@index([clienteId, ativo])
}

model EntregaPush {
  id String @id @default(cuid())
  notificacaoId String
  assinaturaId String
  status String @default("PENDENTE")
  tentativas Int @default(0)
  proximaTentativaEm DateTime @default(now())
  confirmadaEm DateTime?
  createdAt DateTime @default(now())
  notificacao NotificacaoCliente @relation(fields: [notificacaoId], references: [id], onDelete: Cascade)
  assinatura AssinaturaPush @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)
  @@unique([notificacaoId, assinaturaId])
  @@index([status, proximaTentativaEm])
}

model GuiaOperadora {
  id String @id @default(cuid())
  lojaId String
  operadora String
  topico String
  titulo String
  resumo String
  passos String[]
  fonte String
  canalOficial String
  revisadoEm DateTime
  validoAte DateTime
  responsavelId String
  publicado Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loja Loja @relation(fields: [lojaId], references: [id])
  @@index([lojaId, operadora, publicado, validoAte])
}

model Servico {
  id String @id @default(cuid())
  lojaId String
  titulo String
  descricao String
  preco Decimal? @db.Decimal(10,2)
  ativo Boolean @default(true)
  agendamento Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loja Loja @relation(fields: [lojaId], references: [id])
  solicitacoes SolicitacaoServico[]
  horarios HorarioServico[]
  @@index([lojaId, ativo])
}

model SolicitacaoServico {
  id String @id @default(cuid())
  lojaId String
  clienteId String
  servicoId String
  horarioId String?
  chaveIdempotencia String
  protocolo String @unique
  aparelho String
  problema String
  status String @default("RECEBIDA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loja Loja @relation(fields: [lojaId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])
  servico Servico @relation(fields: [servicoId], references: [id])
  horario HorarioServico? @relation(fields: [horarioId], references: [id])
  historico HistoricoServico[]
  orcamentos OrcamentoServico[]
  @@unique([clienteId, chaveIdempotencia])
  @@index([lojaId, createdAt])
  @@index([clienteId, createdAt])
  @@index([horarioId, status])
}

model OrcamentoServico {
  id String @id @default(cuid())
  solicitacaoId String
  versao Int
  valorCentavos Int
  descricao String
  validoAte DateTime
  status String @default("PENDENTE")
  decididoEm DateTime?
  emitidoPorId String
  createdAt DateTime @default(now())
  solicitacao SolicitacaoServico @relation(fields: [solicitacaoId], references: [id], onDelete: Restrict)
  emitidoPor Usuario @relation(fields: [emitidoPorId], references: [id], onDelete: Restrict)
  @@unique([solicitacaoId, versao])
}

model HorarioServico {
  id String @id @default(cuid())
  servicoId String
  inicio DateTime
  fim DateTime
  capacidade Int
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  servico Servico @relation(fields: [servicoId], references: [id])
  solicitacoes SolicitacaoServico[]
  @@unique([servicoId, inicio])
  @@index([servicoId, inicio, ativo])
}

model HistoricoServico {
  id String @id @default(cuid())
  solicitacaoId String
  status String
  mensagem String
  createdAt DateTime @default(now())
  solicitacao SolicitacaoServico @relation(fields: [solicitacaoId], references: [id])
  @@index([solicitacaoId, createdAt])
}

model Produto {
  id            String   @id @default(cuid())
  lojaId        String
  nome          String
  sub           String
  categoria     String
  preco         Decimal  @db.Decimal(10,2)
  precoOriginal Decimal? @db.Decimal(10,2)
  badge         String?
  imgUrl        String
  descricao     String
  estoque       Int      @default(0)
  ativo         Boolean  @default(true)
  destaque      Boolean  @default(false)
  specs         String[]
  atributosTecnicos Json @default("{}")
  atributosVerificadosEm DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  loja          Loja     @relation(fields: [lojaId], references: [id])
  itensPedido   ItemPedido[]
  promocoes     Promocao[]
  favoritos     Favorito[]
  aparelhosCompativeis CompatibilidadeProduto[] @relation("AcessorioCompativel")
  acessoriosCompativeis CompatibilidadeProduto[] @relation("AparelhoCompativel")
  @@index([lojaId, ativo, destaque])
}

model CompatibilidadeProduto {
  id String @id @default(cuid())
  acessorioId String
  aparelhoId String
  observacao String
  atributosAcessorio Json @default("{}")
  atributosAparelho Json @default("{}")
  aprovadoPorId String
  aprovadoEm DateTime @default(now())
  acessorio Produto @relation("AcessorioCompativel", fields: [acessorioId], references: [id], onDelete: Cascade)
  aparelho Produto @relation("AparelhoCompativel", fields: [aparelhoId], references: [id], onDelete: Cascade)
  aprovadoPor Usuario @relation(fields: [aprovadoPorId], references: [id], onDelete: Restrict)
  @@unique([acessorioId, aparelhoId])
  @@index([aparelhoId])
}

model Novidade {
  id String @id @default(cuid())
  lojaId String
  titulo String
  resumo String
  texto String
  fonte String
  publicado Boolean @default(false)
  arquivado Boolean @default(false)
  versao Int @default(0)
  revisadoEm DateTime
  revisadoPorId String?
  revisadoPor Usuario? @relation(fields: [revisadoPorId], references: [id], onDelete: Restrict)
  validoAte DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Restrict)
  @@index([lojaId, publicado, validoAte])
}

model Pedido {
  id         String      @id @default(cuid())
  lojaId     String
  clienteId  String
  codigo     String      // #VOX-001 style
  status     StatusPedido @default(NOVO)
  pagamento  String
  checkoutKey String?
  estoqueReservado Boolean @default(false)
  canceladoEm DateTime?
  total      Decimal     @db.Decimal(10,2)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  loja       Loja        @relation(fields: [lojaId], references: [id])
  cliente    Cliente     @relation(fields: [clienteId], references: [id])
  itens      ItemPedido[]
  timeline   TimelinePedido[]

  @@unique([lojaId, codigo])
  @@unique([clienteId, checkoutKey])
  @@index([lojaId, createdAt])
  @@index([clienteId, createdAt])
}

enum StatusPedido {
  NOVO
  EM_PREPARO
  PRONTO
  ENTREGUE
}

model Favorito {
  clienteId String
  produtoId String
  createdAt DateTime @default(now())
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  @@id([clienteId, produtoId])
  @@index([produtoId])
}

model ItemPedido {
  id        String   @id @default(cuid())
  pedidoId  String
  produtoId String
  nome      String
  qty       Int
  preco     Decimal  @db.Decimal(10,2)

  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto   Produto  @relation(fields: [produtoId], references: [id])
  @@index([pedidoId])
}

model TimelinePedido {
  id        String   @id @default(cuid())
  pedidoId  String
  status    String
  data      DateTime?
  ok        Boolean  @default(false)
  ordem     Int

  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  @@index([pedidoId, ordem])
}

model Promocao {
  id            String   @id @default(cuid())
  lojaId        String
  produtoId     String
  titulo        String
  descricao     String
  preco         Decimal  @db.Decimal(10,2)
  precoOriginal Decimal  @db.Decimal(10,2)
  validade      DateTime
  ativa         Boolean  @default(true)
  createdAt     DateTime @default(now())

  loja    Loja    @relation(fields: [lojaId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
  @@index([lojaId, ativa, validade])
}

model RecompensaCatalogo {
  id       String  @id @default(cuid())
  lojaId   String
  titulo   String
  pontos   Int
  ativo    Boolean @default(true)

  loja     Loja    @relation(fields: [lojaId], references: [id])
  resgates ResgateRecompensa[]
  @@index([lojaId, ativo])
}

model ResgateRecompensa {
  id            String   @id @default(cuid())
  clienteId     String
  recompensaId  String
  codigo        String   @unique
  chaveResgate  String?
  usadoEm       DateTime?
  createdAt     DateTime @default(now())

  recompensa    RecompensaCatalogo @relation(fields: [recompensaId], references: [id])
  @@unique([clienteId, chaveResgate])
}

model HistoricoPontos {
  id        String   @id @default(cuid())
  clienteId String
  pontos    Int
  tipo      TipoPontos
  descricao String
  createdAt DateTime @default(now())

  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  @@index([clienteId, createdAt])
}

enum TipoPontos {
  GANHO
  RESGATE
  BONUS
}

model ConsentimentoCliente {
  id String @id @default(cuid())
  clienteId String
  personalizacao Boolean
  notificacoes Boolean
  versaoAviso String
  createdAt DateTime @default(now())
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  @@index([clienteId, createdAt])
}
