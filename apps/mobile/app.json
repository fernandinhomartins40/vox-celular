{
  "expo": {
    "name": "Vox Celular",
    "slug": "vox-celular",
    "scheme": "voxcelular",
    "version": "0.1.0",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.voxcelular.cliente",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.voxcelular.cliente"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
