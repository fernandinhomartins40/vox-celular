{
    "expo":  {
                 "name":  "Vox Celular",
                 "slug":  "vox-celular",
                 "scheme":  "voxcelular",
                 "version":  "0.1.0",
                 "platforms":  [
                                   "android",
                                   "ios"
                               ],
                 "orientation":  "portrait",
                 "userInterfaceStyle":  "light",
                 "plugins":  [
                                 "expo-router",
                                 "expo-secure-store",
                                 "expo-status-bar"
                             ],
                 "ios":  {
                             "supportsTablet":  true,
                             "bundleIdentifier":  "br.com.voxcelular.cliente",
                             "infoPlist":  {
                                               "ITSAppUsesNonExemptEncryption":  false
                                           },
                             "associatedDomains":  [
                                                       "applinks:www.voxcelular.com.br",
                                                       "applinks:voxcelular.com.br"
                                                   ]
                         },
                 "android":  {
                                 "package":  "br.com.voxcelular.cliente",
                                 "intentFilters":  [
                                                       {
                                                           "category":  [
                                                                            "BROWSABLE",
                                                                            "DEFAULT"
                                                                        ],
                                                           "data":  [
                                                                        {
                                                                            "scheme":  "https",
                                                                            "host":  "www.voxcelular.com.br",
                                                                            "pathPrefix":  "/assistente"
                                                                        },
                                                                        {
                                                                            "scheme":  "https",
                                                                            "host":  "www.voxcelular.com.br",
                                                                            "pathPrefix":  "/novidades"
                                                                        },
                                                                        {
                                                                            "scheme":  "https",
                                                                            "host":  "www.voxcelular.com.br",
                                                                            "pathPrefix":  "/area-cliente"
                                                                        },
                                                                        {
                                                                            "scheme":  "https",
                                                                            "host":  "www.voxcelular.com.br",
                                                                            "pathPrefix":  "/produto"
                                                                        },
                                                                        {
                                                                            "scheme":  "https",
                                                                            "host":  "voxcelular.com.br",
                                                                            "pathPrefix":  "/assistente"
                                                                        },
                                                                        {
                                                                            "scheme":  "https",
                                                                            "host":  "voxcelular.com.br",
                                                                            "pathPrefix":  "/novidades"
                                                                        },
                                                                        {
                                                                            "scheme":  "https",
                                                                            "host":  "voxcelular.com.br",
                                                                            "pathPrefix":  "/area-cliente"
                                                                        },
                                                                        {
                                                                            "scheme":  "https",
                                                                            "host":  "voxcelular.com.br",
                                                                            "pathPrefix":  "/produto"
                                                                        }
                                                                    ],
                                                           "action":  "VIEW",
                                                           "autoVerify":  true
                                                       }
                                                   ]
                             },
                 "experiments":  {
                                     "typedRoutes":  true
                                 }
             }
}
